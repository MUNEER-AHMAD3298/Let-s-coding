#include <iostream>
using namespace std;
#include <climits>
int main() {
    //Wave form Print in  2D array
    int n,m;
    cout<<"Enter the numbers of rows and columns of 2D array"<<endl;
    cin>>n>>m;
    int arr[n][m];
    for (int i=0;i<n;i++) {
        for (int j=0;j<m;j++) {
            cin>>arr[i][j];
        }
    }
    for (int j=0;j<n;j++) {
        if (j%2==0)
            for (int i=0;i<m;i++)
                cout<<arr[i][j]<<" ";
        else
            for (int i=m-1;i>=0;i--)
                cout<<arr[i][j]<<" ";
        cout<<endl;

    }

    return EXIT_SUCCESS;
}
