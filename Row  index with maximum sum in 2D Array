#include <iostream>
using namespace std;
#include <climits>
int main() {
    //Row Index with maximum sum
    int n,m;
    cout<<"Enter the numbers of rows and columns of 2D array"<<endl;
    cin>>n>>m;
    int arr[n][m];
    int max=INT_MIN;
    int index=-1;
    long long int sum=0;
    for (int i=0;i<n;i++) {
        for (int j=0;j<m;j++) {
            cin>>arr[i][j];
            sum+=arr[i][j];
        }
        if (sum>max)
            index=i;
    }
    cout<<"Row with maximum sum is "<<index+1<<"th Row with Index "<<index<<endl;
    return 0;
}
