#include <iostream>
using namespace std;
#include <vector>
void increment(int *p) {
    *p=*p+1;
}
void swapping(int *p1,int *p2) {
    int temp=*p1;
    *p1=*p2;
    *p2=temp;
}
void dob(int *ptr){
    for(int i=0;i<5;i++) {
        ptr[i]=ptr[i]*2;
    }

}
void  swapbyreference(int &p1,int &p2) {
    int temp=p1;
    p1=p2;
    p2=temp;
}
void initalize(vector<int>&v1){
    for(int i=0;i<5;i++)
        v1[i]=20;
}
int main() {
    //Pointers in Functions || Pass by pointers

    // pass by pointers
    cout<<"Increasing value of n"<<endl;
    int n=10;
    cout<<n<<endl;
    increment(&n);
    cout<<n<<endl;

    cout<<"Swapping two number by pointers "<<endl;
    int first=10;
    int second=20;
    cout<<first<<" "<<second<<endl;
    swapping(&first,&second);
    cout<<first<<" "<<second<<endl;

    cout<<"Double each element of array"<<endl;
    int arr[5]={1,2,3,4,5};
    for(int i=0;i<5;i++) {
        cout<<arr[i]<<" ";
    }
    cout<<endl;
    dob(arr);
    cout<<"After double each elements of array"<<endl;
    for(int i=0;i<5;i++) {
        cout<<arr[i]<<" ";
        }
    cout<<endl;
    //Reference Variable
    cout<<"Reference Variable"<<endl;
    int x=10;
    int &temp=x;
    temp++;
    cout<<x<<endl;
    cout<<temp<<endl;

    cout<<"Swapping two number by using reference variable"<<endl;
    int s=10;
    int t=20;
    cout<<"Before Swapping"<<endl;
    cout<<s<<" "<<t<<endl;
    cout<<"After Swapping"<<endl;
    swapbyreference(s,t);
    cout<<s<<" "<<t<<endl;

    cout<<"Initialize all values of vector by 20"<<endl;
    cout<<"Before initialing all values are 0 "<<endl;
    vector<int>v(5,0);
    for(int i=0;i<5;i++)
      cout<<v[i]<<" ";
    cout<<endl;

    initalize(v);
    cout<<"After Initializing all values become 20"<<endl;
    for(int i=0;i<5;i++)
        cout<<v[i]<<" ";
    cout<<endl;




    return EXIT_SUCCESS;
}
