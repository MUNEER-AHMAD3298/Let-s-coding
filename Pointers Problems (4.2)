#include <iostream>
using namespace std;
void second(int *p1,int *p2) {
    p1=p2;
    *p1=2;
}
int four(int x,int *py,int **ppz) {
    int y,z;
    **ppz+=1;
    z=**ppz;
    *py+=2;
    y=*py;
    x+=3;
    return x+y+z;
}
void five(char *str1,char *str2) {
    while (*str1=*str2) {
        str1++,str2++;
    }
}
int main() {
    //Double pointers Problems and solutions
    cout<<"First Problem "<<endl;
    char c[]="GATE2024";
    char *p=c;
    cout<<p+p[3]-p[1]<<endl;

    cout<<"Second Problem "<<endl;
    int i=0,j=1;
    second(&i,&j);
    cout<<i<<" "<<j<<endl;
    
    cout<<"Third  Problem "<<endl;
    int *ptr;
    int x=0;
    ptr=&x;
    int y=*ptr;
    *ptr=1;
    cout<<x<<" "<<y<<endl;

    cout<<"Fourth Problem "<<endl;
    int a=5,b=10;
    int &name=a;
    int *p1=&a;
    (*p1)++;
    p1=&b;
    *p1=*p1+5;
    name+=5;
    cout<<a<<" "<<b<<endl;

    cout<<"Fifth Problem "<<endl;
   int k,*p2,**p3;
    k=4;
    p2=&k;
    p3=&p2;
    cout<<four(k,p2,p3)<<endl;

    cout<<"Sixth Problem "<<endl;
    char first[]="Mohit";
    char second[]="Rohan";
    five(first,second);
    cout<<first;

    return EXIT_SUCCESS;
}
