#include <iostream>
using namespace std;
#include <climits>
int main() {
    //Transpose Matrix in  2D array
    int n,m;
    cout<<"Enter the numbers of rows and columns of 2D array"<<endl;
    cin>>n>>m;
    int arr[n][m];
    for (int i=0;i<n;i++) {
        for (int j=0;j<m;j++) {
            cin>>arr[i][j];
        }
    }
    for (int i=0;i<n;i++) {
        for (int j=i+1;j<m;j++) {
            swap(arr[i][j],arr[j][i]);
        }
    }
    for (int i=0;i<n;i++) {
        for (int j=0;j<m;j++) {
            cout<<arr[i][j]<<" ";
        }
        cout<<endl;
    }

    return EXIT_SUCCESS;
}
